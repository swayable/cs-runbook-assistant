# Required
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
NOTION_TOKEN=secret_your-notion-token
NOTION_ROOT_PAGE_ID=your-root-page-id
LINEAR_API_KEY=lin_api_your-key

# Optional: Linear settings
LINEAR_TEAM_KEY=ENG
LINEAR_LABEL_NAME=CS Requests
LINEAR_TIMEOUT_MS=5000

# Optional: Cache & storage
PUBLIC_BASE_URL=http://localhost:8000
MEM_CACHE_TTL_MS=3600000
BLOB_KEY=cs_runbook_index_v1
BLOB_KEY_V2=cs_runbook_index_v2

# Optional: LLM features (Anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key

# Optional: Hybrid search with embeddings (OpenAI)
OPENAI_API_KEY=sk-your-openai-key
HYBRID_SEARCH_ENABLED=1

# Optional: LLM Director
LLM_DIRECTOR_ENABLED=1
LLM_DIRECTOR_MODEL=claude-3-5-haiku-20241022
LLM_DIRECTOR_TIMEOUT_MS=8000
